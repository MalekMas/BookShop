<%- include('../partials/head', { title: PageTitle }) %>

<style>
  .orders-container {
    max-width: 760px;
    margin: 60px auto;
    padding: 40px;
    border-radius: 18px;
    background: #f2f3f7;
    box-shadow: 0 6px 25px rgba(0, 0, 0, 0.07);
    color: #222831;
  }
  .order {
    margin-bottom: 20px;
    padding: 20px 25px;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 3px 15px rgba(0, 0, 0, 0.05);
  }
  .order-title, .order-total { font-weight: 700; }
  .order-items { margin: 12px 0; }
</style>

<div class="orders-container">
  <h2>Your Orders</h2>

  <% if (orders.length === 0) { %>
    <p>You have not placed any orders yet.</p>
  <% } %>

  <% orders.forEach((order) => { %>
    <div class="order">
      <div class="order-title">Order #<%= order._id %> - <%= order.createdAt.toLocaleDateString() %></div>
      <ul class="order-items">
        <% order.items.forEach((item) => { %>
          <li><%= item.title %> (x<%= item.quantity %>)</li>
        <% }) %>
      </ul>
      <div class="order-total">Total: $<%= order.total.toFixed(2) %></div>
    </div>
  <% }) %>
</div>

<%- include('../partials/footer') %>
